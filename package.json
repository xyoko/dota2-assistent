{
  "name": "dota2-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://xyoko.github.io/dota2-assistent/",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
